flowchart TB
    subgraph Hardware["🔧 ESP32 Key Cabinet"]
        ESP["ESP32 Dev Board"]
        Relay["Solenoid Relay (GPIO4)"]
        Switch["Microswitch (GPIO5)"]
        LED["Status LED (GPIO2)"]
        ESP --> Relay & Switch & LED
    end

    subgraph PWA["📱 PWA (Firebase Hosting)"]
        Login["Login Screen"]
        Dashboard["Dashboard"]
        Admin["Admin Hub"]
        Login -->|"Google Sign-In"| Dashboard
        Dashboard --> Admin
    end

    subgraph Cloud["☁️ Firebase"]
        Auth["Authentication (Google)"]
        RTDB[("Realtime Database")]
        Auth --> RTDB
    end

    subgraph Offline["📦 Offline Queue"]
        LS[("localStorage Buffer")]
    end

    PWA <-->|"Web Bluetooth"| ESP
    PWA -->|"Sign in / session"| Auth
    PWA -->|"Firebase SDK: users, audit, invites"| RTDB
    PWA -.->|"Offline: queue"| LS
    LS -.->|"Reconnect: flush + push audit"| RTDB

    style Hardware fill:#1a1a2e,color:#e94560,stroke:#e94560
    style PWA fill:#0f3460,color:#00b4d8,stroke:#00b4d8
    style Cloud fill:#16213e,color:#f77f00,stroke:#f77f00
    style Storage fill:#1a1a2e,color:#06d6a0,stroke:#06d6a0